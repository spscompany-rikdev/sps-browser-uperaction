<?xml version="1.0" encoding="utf-8"?>
<!-- Only HTTPS, and only the phone's built-in trusted certificate authorities (certificates a user or app installed are NOT trusted). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
