<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">SPS Browser</string>
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:colorAccent">#1A73E8</item>
        <item name="android:colorPrimary">#FFFFFF</item>
        <item name="android:statusBarColor">#FFFFFF</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:alertDialogTheme">@style/SpsDialog</item>
        <item name="android:dialogTheme">@style/SpsDialog</item>
    </style>
    <!-- Rounded pop-up cards that grow out of the top-right corner (the "drop-down" look) for every dialog -->
    <style name="SpsDialogAnim" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/dd_in</item>
        <item name="android:windowExitAnimation">@anim/dd_out</item>
    </style>
    <style name="SpsDialog" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_round</item>
        <item name="android:windowAnimationStyle">@style/SpsDialogAnim</item>
        <item name="android:colorAccent">#1A73E8</item>
        <item name="android:windowMinWidthMajor">80%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>
</resources>
